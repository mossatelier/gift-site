/* 全局样式 —— H5 主题：暖米色 + 红金 */

page {
  --bg: #f4f1ea;
  --paper: #ffffff;
  --paper-soft: #fffaf3;
  --line: #eadfce;
  --text: #1d1b18;
  --muted: #72695c;
  --red: #d64b2a;
  --red-deep: #b53b1b;
  --gold: #e0ac4d;
  --blue: #2e78b7;
  --green: #167a61;
  --purple: #6d5bb3;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB",
    "Microsoft YaHei", "Noto Sans SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.page-shell {
  padding: 0 24rpx 32rpx;
  box-sizing: border-box;
}

/* 通用纸卡 */
.card {
  background: var(--paper);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.08);
}

/* 区段标题条 */
.section {
  margin-top: 36rpx;
}

.section-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 6rpx;
}

.banner-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.banner-more {
  font-size: 26rpx;
  color: var(--muted);
}

/* 商品网格 */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.product-grid-3 {
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.product-card {
  background: var(--paper);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.08);
  display: flex;
  flex-direction: column;
  border: 1rpx solid var(--line);
}

.product-card .product-image {
  width: 100%;
  aspect-ratio: 1 / 1;
  background: var(--paper-soft);
}

.product-card .product-info {
  padding: 16rpx 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.product-card .product-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}

.product-card .product-price {
  font-size: 26rpx;
  color: var(--red);
  font-weight: 700;
}

.product-card .product-cards-needed {
  font-size: 22rpx;
  color: var(--muted);
}

/* 空状态 */
.empty-state {
  padding: 80rpx 0;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

/* 加载状态 */
.loading-state {
  padding: 40rpx 0;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

/* 兑换方式标签 —— 行内，放在商品标题前。颜色区分两种兑换方式，避免客户混淆 */
.title-tag {
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
}
/* 办卡可兑 —— 红色（信用卡/办卡，主色） */
.title-tag-card {
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
}
/* 推荐可兑 —— 青绿色（推荐他人，与办卡明显区分） */
.title-tag-referral {
  background: linear-gradient(135deg, #1f9488 0%, #36b39e 100%);
}

/* 悬浮按钮通用样式 */
.float-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid var(--line);
  box-shadow: 0 6rpx 18rpx rgba(46, 35, 18, 0.16);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

/* 点击反馈：按下缩小 10% */
.float-btn:active {
  transform: scale(0.9);
}

.float-btn-primary {
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  border: none;
}

.float-emoji {
  font-size: 38rpx;
  line-height: 1;
}

.float-top {
  font-size: 40rpx;
  line-height: 1;
  color: var(--muted);
}

.float-label {
  font-size: 18rpx;
  color: var(--muted);
}

.float-btn-primary .float-label {
  color: #fff;
}

/* 咨询：可拖动，默认右下；返回顶部：其上方 */
.float-chat {
  position: fixed;
  right: 20rpx;
  bottom: 230rpx;
  z-index: 51;
}

.float-top-btn {
  position: fixed;
  right: 20rpx;
  bottom: 120rpx;
  z-index: 50;
}

/* 返回顶部：首屏隐藏 */
.float-top-btn.hide {
  opacity: 0;
  transform: scale(0.4);
  pointer-events: none;
}

/* 商品卡上的小心愿单按钮（覆盖在图片右上角） */
.card-heart-btn {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 14rpx rgba(46, 35, 18, 0.18);
  z-index: 5;
}

.card-heart-svg {
  width: 30rpx;
  height: 30rpx;
}

/* 主按钮 —— 红金渐变 */
.primary-btn {
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  color: #fff;
  border-radius: 999rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  box-shadow: 0 8rpx 18rpx rgba(214, 75, 42, 0.25);
}

.primary-btn::after {
  border: none;
}

/* ===== 图文须知页（文字版，替代单图，清晰可选） ===== */
.guide-page { padding: 24rpx; }
.guide-hero {
  background: linear-gradient(135deg, #ff8a3d 0%, #e8531f 100%);
  border-radius: 22rpx;
  padding: 40rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(232,83,31,0.22);
}
.guide-hero-title { font-size: 46rpx; font-weight: 800; color: #fff; letter-spacing: 2rpx; }
.guide-hero-sub { display: block; margin-top: 12rpx; font-size: 25rpx; color: rgba(255,255,255,0.94); line-height: 1.5; }
.guide-block {
  background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx;
  box-shadow: var(--shadow); border: 1rpx solid var(--line);
}
.guide-block-head { display: flex; align-items: center; gap: 10rpx; margin-bottom: 14rpx; }
.guide-tag {
  display: inline-block; background: linear-gradient(135deg,#ff8a3d,#e8531f);
  color: #fff; font-weight: 800; font-size: 26rpx; padding: 6rpx 20rpx; border-radius: 8rpx;
}
.guide-tag-warn { background: linear-gradient(135deg,#e8531f,#c0392b); }
.guide-block-text { font-size: 27rpx; color: #5d5140; line-height: 1.75; }
.guide-step { display: flex; gap: 16rpx; align-items: flex-start; margin-bottom: 20rpx; }
.guide-step:last-child { margin-bottom: 0; }
.guide-step-no {
  flex: 0 0 auto; width: 46rpx; height: 46rpx; line-height: 46rpx; text-align: center;
  border-radius: 10rpx; background: #e8531f; color: #fff; font-weight: 800; font-size: 24rpx;
}
.guide-step-text { flex: 1; font-size: 27rpx; color: #2e2318; line-height: 1.6; }
/* 银行新户表 */
.guide-table { background: #fff; border-radius: 20rpx; overflow: hidden; box-shadow: var(--shadow); border: 1rpx solid var(--line); }
.guide-tr { display: flex; border-bottom: 1rpx solid var(--line); }
.guide-tr:last-child { border-bottom: none; }
.guide-tr-head { background: #fff3e8; }
.guide-th, .guide-td { padding: 18rpx 10rpx; font-size: 23rpx; box-sizing: border-box; }
.guide-c-bank { flex: 0 0 140rpx; font-weight: 700; color: #2e2318; border-right: 1rpx solid var(--line); }
.guide-c-def { flex: 1; color: #5d5140; border-right: 1rpx solid var(--line); line-height: 1.5; }
.guide-c-tel { flex: 0 0 110rpx; text-align: center; color: #e8531f; font-weight: 700; }
.guide-tr-head .guide-th { font-weight: 800; color: #8a5a2a; text-align: center; }
.guide-note {
  margin-top: 18rpx; background: #fff7ea; border: 1rpx solid rgba(224,172,77,0.5);
  border-radius: 14rpx; padding: 20rpx; font-size: 24rpx; color: #8a5a2a; line-height: 1.6;
}
