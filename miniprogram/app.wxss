/* 全局样式 —— H5 主题：暖米色 + 红金 */

page {
  --bg: #f4f1ea;
  --paper: #ffffff;
  --paper-soft: #fffaf3;
  --line: #eadfce;
  --text: #1d1b18;
  --muted: #72695c;
  --red: #d64b2a;
  --red-deep: #b53b1b;
  --gold: #e0ac4d;
  --blue: #2e78b7;
  --green: #167a61;
  --purple: #6d5bb3;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB",
    "Microsoft YaHei", "Noto Sans SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.page-shell {
  padding: 0 24rpx 32rpx;
  box-sizing: border-box;
}

/* 通用纸卡 */
.card {
  background: var(--paper);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.08);
}

/* 区段标题条 */
.section {
  margin-top: 36rpx;
}

.section-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 6rpx;
}

.banner-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.banner-more {
  font-size: 26rpx;
  color: var(--muted);
}

/* 商品网格 */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.product-grid-3 {
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.product-card {
  background: var(--paper);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.08);
  display: flex;
  flex-direction: column;
  border: 1rpx solid var(--line);
}

.product-card .product-image {
  width: 100%;
  aspect-ratio: 1 / 1;
  background: var(--paper-soft);
}

.product-card .product-info {
  padding: 16rpx 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.product-card .product-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}

.product-card .product-price {
  font-size: 26rpx;
  color: var(--red);
  font-weight: 700;
}

.product-card .product-cards-needed {
  font-size: 22rpx;
  color: var(--muted);
}

/* 空状态 */
.empty-state {
  padding: 80rpx 0;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

/* 加载状态 */
.loading-state {
  padding: 40rpx 0;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

/* 兑换方式标签 —— 行内，放在商品标题前。颜色区分两种兑换方式，避免客户混淆 */
.title-tag {
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
}
/* 办卡可兑 —— 红色（信用卡/办卡，主色） */
.title-tag-card {
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
}
/* 推荐可兑 —— 青绿色（推荐他人，与办卡明显区分） */
.title-tag-referral {
  background: linear-gradient(135deg, #1f9488 0%, #36b39e 100%);
}

/* 悬浮按钮通用样式 */
.float-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid var(--line);
  box-shadow: 0 6rpx 18rpx rgba(46, 35, 18, 0.16);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

/* 点击反馈：按下缩小 10% */
.float-btn:active {
  transform: scale(0.9);
}

.float-btn-primary {
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  border: none;
}

.float-emoji {
  font-size: 38rpx;
  line-height: 1;
}

.float-top {
  font-size: 40rpx;
  line-height: 1;
  color: var(--muted);
}

.float-label {
  font-size: 18rpx;
  color: var(--muted);
}

.float-btn-primary .float-label {
  color: #fff;
}

/* 咨询：可拖动，默认右下；返回顶部：其上方 */
.float-chat {
  position: fixed;
  right: 20rpx;
  bottom: 230rpx;
  z-index: 51;
}

.float-top-btn {
  position: fixed;
  right: 20rpx;
  bottom: 120rpx;
  z-index: 50;
}

/* 返回顶部：首屏隐藏 */
.float-top-btn.hide {
  opacity: 0;
  transform: scale(0.4);
  pointer-events: none;
}

/* 商品卡上的小心愿单按钮（覆盖在图片右上角） */
.card-heart-btn {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 14rpx rgba(46, 35, 18, 0.18);
  z-index: 5;
}

.card-heart-svg {
  width: 30rpx;
  height: 30rpx;
}

/* 主按钮 —— 红金渐变 */
.primary-btn {
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  color: #fff;
  border-radius: 999rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  box-shadow: 0 8rpx 18rpx rgba(214, 75, 42, 0.25);
}

.primary-btn::after {
  border: none;
}

/* ===== 图文须知页（文字版·海报风，对标原图） ===== */
.guide-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 70rpx;
  background: linear-gradient(180deg, #ffc078 0%, #ff9a4d 42%, #f57c2e 100%);
}
.guide-hero { text-align: center; padding: 20rpx 0 34rpx; }
.guide-hero-title {
  display: inline-block;
  font-size: 58rpx; font-weight: 800; color: #fff; letter-spacing: 4rpx;
  text-shadow: 0 4rpx 0 rgba(193,68,20,0.55), 0 10rpx 18rpx rgba(120,40,10,0.25);
}
.guide-hero-sub {
  display: inline-block; margin-top: 18rpx; font-size: 25rpx; color: #fff; line-height: 1.5;
  background: rgba(255,255,255,0.2); padding: 12rpx 26rpx; border-radius: 999rpx;
}

.guide-block {
  position: relative;
  background: #fffdf6;
  border-radius: 28rpx;
  padding: 32rpx 30rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 14rpx 30rpx rgba(150,64,18,0.2);
}
.guide-block-head { display: flex; align-items: center; margin-bottom: 18rpx; }
.guide-tag {
  display: inline-block;
  background: linear-gradient(135deg, #ff8a3d, #ee5a22);
  color: #fff; font-weight: 800; font-size: 28rpx;
  padding: 9rpx 26rpx; border-radius: 12rpx;
  box-shadow: 0 5rpx 12rpx rgba(232,83,31,0.32);
}
.guide-tag-warn { background: linear-gradient(135deg, #ef4e3a, #c0392b); }
.guide-block-text { font-size: 28rpx; color: #5a4632; line-height: 1.85; }
.guide-block-text-warn { color: #d64b2a; font-weight: 600; }

.guide-step { display: flex; gap: 18rpx; align-items: flex-start; margin-bottom: 26rpx; }
.guide-step:last-child { margin-bottom: 0; }
.guide-step-no {
  flex: 0 0 auto; width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center;
  border-radius: 14rpx; background: linear-gradient(135deg,#ff8a3d,#ee5a22); color: #fff;
  font-weight: 800; font-size: 28rpx; box-shadow: 0 5rpx 12rpx rgba(232,83,31,0.32);
}
.guide-step-text { flex: 1; font-size: 28rpx; color: #4a3a28; line-height: 1.7; padding-top: 8rpx; }

/* 银行新户表 */
.guide-table {
  background: #fffdf6; border-radius: 24rpx; overflow: hidden;
  box-shadow: 0 14rpx 30rpx rgba(150,64,18,0.2);
}
.guide-tr { display: flex; }
.guide-tr + .guide-tr { border-top: 1rpx solid #f1e3ce; }
.guide-tr-head { background: linear-gradient(135deg, #ffd9a8, #ffc585); }
.guide-th, .guide-td { padding: 22rpx 12rpx; font-size: 23rpx; box-sizing: border-box; line-height: 1.5; }
.guide-c-bank { flex: 0 0 138rpx; font-weight: 800; color: #3a2a18; }
.guide-c-def { flex: 1; color: #5a4632; }
.guide-c-tel { flex: 0 0 108rpx; text-align: center; color: #ee5a22; font-weight: 800; }
.guide-tr-head .guide-th { font-weight: 800; color: #8a4a18; text-align: center; }

.guide-note {
  margin-top: 24rpx; background: rgba(255,255,255,0.92);
  border: 1rpx dashed rgba(193,68,20,0.45);
  border-radius: 16rpx; padding: 22rpx; font-size: 24rpx; color: #b5471b; line-height: 1.65;
}
