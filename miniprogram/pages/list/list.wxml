<view class="page-shell">
 <view class="list-sticky">
  <!-- 搜索条 -->
  <view class="search-bar">
    <input
      class="search-input"
      type="text"
      placeholder="搜索礼品、活动、办卡专区"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      confirm-type="search"
      bindconfirm="onSearch"
    />
    <view class="search-button" bindtap="onSearch">搜索</view>
  </view>

  <!-- 积分筛选行（区间分档，固定在搜索下方、品类上方）；切到推荐有礼时只清空选择、不隐藏 -->
  <scroll-view class="cards-filter-bar" scroll-x enable-flex>
    <view
      class="cards-chip {{cards === item.key ? 'active' : ''}}"
      wx:for="{{cardsBuckets}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onSelectCards"
    >{{item.label}}</view>
    <view class="cards-chip cards-chip-reset {{cards === '' ? 'disabled' : ''}}" bindtap="resetCards">重置</view>
  </scroll-view>

  <!-- 分类筛选条（展示大类 + 更多下拉） -->
  <view class="category-row">
    <scroll-view class="category-bar" scroll-x enable-flex>
      <view
        class="category-chip {{currentCategory === item.value ? 'active' : ''}}"
        wx:for="{{displayCats}}"
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="onCategoryTap"
      >{{item.label}}</view>
    </scroll-view>
    <view class="more-chip {{(showMore || moreLabel) ? 'active' : ''}}" bindtap="toggleMore">{{moreLabel || '更多'}} {{showMore ? '▴' : '▾'}}</view>
  </view>

  <!-- 更多分类下拉面板 -->
  <view class="more-panel" wx:if="{{showMore}}">
    <view
      class="more-item {{currentCategory === item.value ? 'active' : ''}}"
      wx:for="{{moreCats}}"
      wx:key="value"
      data-value="{{item.value}}"
      bindtap="onCategoryTap"
    >{{item.label}}</view>
  </view>

  <!-- 排序 chip 同排（积分 / 最新） -->
  <view class="sort-chips">
    <view
      class="chip-item chip-sort {{(sort === 'cards-asc' || sort === 'cards-desc') ? 'active' : ''}}"
      bindtap="onCardsSortToggle"
    >积分{{sort === 'cards-asc' ? ' ↑' : (sort === 'cards-desc' ? ' ↓' : '')}}</view>
    <view
      class="chip-item {{sort === 'newest' ? 'active' : ''}}"
      data-sort="newest"
      bindtap="onSortChange"
    >最新</view>
  </view>

  <!-- 二级筛选（选中有二级的分类时显示） -->
  <scroll-view class="subcategory-bar" scroll-x enable-flex wx:if="{{subItems.length > 0}}">
    <view class="sub-chip {{currentSub === '' ? 'active' : ''}}" data-sub="" bindtap="onSubTap">全部</view>
    <view
      class="sub-chip {{currentSub === item.value ? 'active' : ''}}"
      wx:for="{{subItems}}"
      wx:key="value"
      data-sub="{{item.value}}"
      bindtap="onSubTap"
    >{{item.label}}</view>
  </scroll-view>
 </view>

  <!-- 数量信息（真实总数） -->
  <view class="product-meta-bar" wx:if="{{totalCount > 0 || items.length > 0}}">
    <text>共 {{totalCount}} 件礼品</text>
    <text wx:if="{{currentCategoryLabel}}">{{currentCategoryLabel}}</text>
  </view>

  <!-- 商品网格 -->
  <block wx:if="{{loading && items.length === 0}}">
    <view class="loading-state">加载中…</view>
  </block>
  <block wx:elif="{{items.length === 0}}">
    <view class="empty-state">没有找到符合条件的礼品</view>
  </block>
  <view wx:else class="product-grid">
    <view
      class="product-card"
      wx:for="{{items}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="goProduct"
    >
      <view class="product-media">
        <image class="product-image" src="{{item.imageUrl}}" mode="aspectFill" lazy-load></image>
        <view class="card-heart-btn" catchtap="toggleHeart" data-id="{{item._id}}">
          <image src="{{wishlistMap[item._id] ? '/images/icons/heart-filled.svg' : '/images/icons/heart.svg'}}" mode="aspectFit" class="card-heart-svg" />
        </view>
      </view>
      <view class="product-body">
        <text class="product-title"><text class="title-tag {{item.category === 'referral' ? 'title-tag-referral' : 'title-tag-card'}}">{{item.category === 'referral' ? '推荐可兑' : '办卡可兑'}}</text>{{item.title}}</text>
        <text class="product-meta" wx:if="{{item._metaText}}">{{item._metaText}}</text>
      </view>
    </view>
  </view>

  <view class="loading-more" wx:if="{{loading && items.length > 0}}">加载更多…</view>
  <view class="loading-more" wx:elif="{{noMore && items.length > 0}}">— 已经到底了 —</view>

  <!-- 咨询：可拖动 -->
  <view class="float-btn float-btn-primary float-chat" style="{{floatStyle}}"
    catchtouchmove="onFloatMove" bindtouchend="onFloatEnd" bindtap="floatService">
    <text class="float-emoji">💬</text>
    <text class="float-label">咨询</text>
  </view>
  <!-- 返回顶部：滚动超半屏才显示 -->
  <view class="float-btn float-top-btn {{showBackTop ? '' : 'hide'}}" bindtap="backToTop">
    <text class="float-top">↑</text>
    <text class="float-label">顶部</text>
  </view>
</view>
