.page-shell {
  padding: 16rpx 24rpx 60rpx;
}

/* 搜索+排序+分类整块吸顶，滚动时随时可筛选 */
.list-sticky {
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--bg);
  margin: -16rpx -24rpx 0;
  padding: 16rpx 24rpx 8rpx;
  box-shadow: 0 6rpx 12rpx rgba(46, 35, 18, 0.04);
}

.search-bar {
  display: flex;
  gap: 12rpx;
  padding: 12rpx 0 16rpx;
}

.search-input {
  flex: 1;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(234, 223, 206, 0.9);
  border-radius: 28rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 35, 18, 0.06);
}

.search-button {
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  color: #fff;
  padding: 16rpx 36rpx;
  border-radius: 22rpx;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 16rpx rgba(214, 75, 42, 0.22);
}

/* 排序 chip 同排 */
.sort-chips {
  display: flex;
  gap: 12rpx;
  padding: 8rpx 0 12rpx;
  flex-wrap: wrap;
}

.chip-item {
  display: inline-block;
  background: rgba(255, 255, 255, 0.92);
  color: var(--text);
  font-size: 24rpx;
  font-weight: 700;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(234, 223, 206, 0.9);
  box-shadow: 0 4rpx 14rpx rgba(46, 35, 18, 0.05);
}

.chip-item.active {
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 8rpx 16rpx rgba(214, 75, 42, 0.22);
}

.category-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 0 16rpx;
}

.category-bar {
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

/* 更多按钮 */
.more-chip {
  flex: 0 0 auto;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text);
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(234, 223, 206, 0.9);
  background: rgba(255, 255, 255, 0.92);
}

.more-chip.active {
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  color: #fff;
  border-color: transparent;
}

/* 更多下拉面板 */
.more-panel {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(46, 35, 18, 0.08);
}

.more-item {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text);
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(234, 223, 206, 0.9);
  background: var(--paper-soft);
}

.more-item.active {
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  color: #fff;
  border-color: transparent;
}

.category-chip {
  display: inline-block;
  background: rgba(255, 255, 255, 0.92);
  color: var(--text);
  font-size: 24rpx;
  font-weight: 700;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
  border: 1rpx solid rgba(234, 223, 206, 0.9);
  box-shadow: 0 4rpx 14rpx rgba(46, 35, 18, 0.05);
}

.category-chip.active {
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 8rpx 16rpx rgba(214, 75, 42, 0.22);
}

/* 子分类条 */
.subcategory-bar {
  white-space: nowrap;
  padding: 0 0 12rpx;
}

.sub-chip {
  display: inline-block;
  background: var(--paper-soft);
  color: var(--muted);
  font-size: 22rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  margin-right: 10rpx;
  border: 1rpx solid rgba(234, 223, 206, 0.7);
}

.sub-chip.active {
  background: rgba(214, 75, 42, 0.1);
  color: var(--red);
  border-color: rgba(214, 75, 42, 0.4);
  font-weight: 700;
}

.product-meta-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 4rpx 12rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.product-card {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(234, 223, 206, 0.9);
  border-radius: 22rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.08);
  display: flex;
  flex-direction: column;
}

.product-media {
  position: relative;
  aspect-ratio: 1 / 1;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-body {
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.product-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-meta {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--red);
}

.loading-more {
  text-align: center;
  color: var(--muted);
  font-size: 22rpx;
  padding: 24rpx 0 40rpx;
}
