<view class="page-shell my-orders-page">
  <view class="loading-state" wx:if="{{loading}}">加载中…</view>

  <view class="orders-empty" wx:elif="{{orders.length === 0}}">
    <text class="empty-icon">📦</text>
    <text class="empty-title">还没有订单</text>
    <text class="empty-text">心愿单选好后提交申请，订单会出现在这里</text>
  </view>

  <view class="order-list" wx:else>
    <view
      class="order-card"
      wx:for="{{orders}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="goDetail"
    >
      <view class="order-head">
        <text class="order-date">{{item.createdText}}</text>
        <text class="order-status status-{{item.status}}">{{item.statusLabel}}</text>
      </view>
      <view class="order-body">
        <image
          wx:if="{{item.firstImage}}"
          class="order-thumb"
          src="{{item.firstImage}}"
          mode="aspectFill"
          lazy-load
        />
        <view class="order-info">
          <text class="order-title">{{item.firstTitle}}</text>
          <text class="order-meta" wx:if="{{item.itemCount > 1}}">共 {{item.itemCount}} 件礼品</text>
          <text class="order-meta" wx:else>1 件礼品</text>
          <text class="order-cards" wx:if="{{item.totalCards > 0}}">合计 {{item.totalCards}} 积分</text>
        </view>
        <text class="order-chevron">›</text>
      </view>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</view>
