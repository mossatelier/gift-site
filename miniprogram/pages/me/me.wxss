.me-page {
  padding-top: 24rpx;
}

/* 头部 */
.me-header {
  background: linear-gradient(135deg, #fffaf3 0%, #fff 100%);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.06);
}

.me-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--paper-soft);
  border: 2rpx solid var(--line);
  flex-shrink: 0;
}

.me-avatar.placeholder {
  padding: 30rpx;
  box-sizing: border-box;
  opacity: 0.55;
}

.me-header-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.me-nick {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.me-sub {
  font-size: 24rpx;
  color: var(--muted);
}

.me-chevron {
  font-size: 40rpx;
  color: var(--muted);
}

/* 区段 */
.me-section {
  margin-top: 28rpx;
  background: var(--paper);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.06);
}

.me-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.me-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.me-section-action {
  font-size: 24rpx;
  color: var(--red);
}

.me-section-body {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.me-section-empty {
  color: var(--muted);
  font-size: 26rpx;
}

.addr-line-main {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.addr-line-sub {
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.5;
}

/* 菜单 */
.me-menu {
  margin-top: 28rpx;
  background: var(--paper);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.06);
  overflow: hidden;
}

.me-menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.me-menu-item:last-child {
  border-bottom: none;
}

.me-menu-icon {
  font-size: 36rpx;
  width: 48rpx;
}

.me-menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.me-menu-chevron {
  font-size: 36rpx;
  color: var(--muted);
}

/* 退出 */
.me-logout {
  margin-top: 40rpx;
  background: var(--paper);
  color: var(--red);
  font-size: 28rpx;
  border-radius: 24rpx;
  padding: 24rpx 0;
  border: 1rpx solid var(--line);
  box-shadow: 0 8rpx 18rpx rgba(46, 35, 18, 0.04);
}

.me-logout::after { border: none; }

.bottom-spacer {
  height: 40rpx;
}

/* 邀友推荐办卡 核心入口 */
.me-referral-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 28rpx 0 0;
  padding: 28rpx 28rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #ff8a3d 0%, #e8531f 100%);
  box-shadow: 0 10rpx 24rpx rgba(232, 83, 31, 0.28);
}
.me-referral-emoji { font-size: 48rpx; }
.me-referral-text { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.me-referral-title { font-size: 30rpx; font-weight: 800; color: #fff; }
.me-referral-sub { font-size: 22rpx; color: rgba(255,255,255,0.9); }
.me-referral-arrow { font-size: 36rpx; color: #fff; }

/* 防冒用警示栏 */
.me-piracy-banner {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #fff8e1;
  border: 1rpx solid #f0d98a;
  color: #8a6d1a;
  font-size: 22rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

/* 我的积分 */
.me-points-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 18rpx 0 0;
  padding: 24rpx 28rpx;
  border-radius: 22rpx;
  background: #fffaf3;
  border: 1rpx solid #f0e4d3;
}
.me-points-icon { font-size: 40rpx; }
.me-points-text { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.me-points-title { font-size: 28rpx; font-weight: 800; color: #3a2f22; }
.me-points-sub { font-size: 22rpx; color: #a08f79; }
.me-points-value { font-size: 30rpx; font-weight: 800; color: #e8531f; }
.me-points-arrow { font-size: 32rpx; color: #c9b79c; margin-left: 4rpx; }
