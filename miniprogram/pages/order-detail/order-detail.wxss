.order-detail-page {
  padding-top: 16rpx;
}

.od-status-card {
  background: var(--paper);
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.06);
}

.od-status-label {
  font-size: 36rpx;
  font-weight: 700;
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
}

.status-pending    { color: var(--red);    background: rgba(214, 75, 42, 0.10); }
.status-preparing  { color: var(--gold);   background: rgba(224, 172, 77, 0.16); }
.status-shipped    { color: #2f6db0;       background: rgba(47, 109, 176, 0.12); }
.status-signed     { color: var(--green);  background: rgba(22, 122, 97, 0.12); }
.status-cancelled  { color: var(--muted);  background: rgba(114, 105, 92, 0.10); }

.od-status-desc {
  font-size: 26rpx;
  color: var(--muted);
}
.od-status-signed {
  font-size: 24rpx;
  color: var(--green);
  margin-top: 4rpx;
}

/* 进度步骤条 */
.od-steps {
  display: flex;
  margin-top: 20rpx;
  background: var(--paper);
  border-radius: 24rpx;
  padding: 28rpx 12rpx;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.06);
}
.od-step {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
/* 连接线：画在每个 step 左侧，连到上一个 */
.od-step::before {
  content: '';
  position: absolute;
  top: 13rpx;
  right: 50%;
  width: 100%;
  height: 4rpx;
  background: #e8ddca;
}
.od-step:first-child::before { display: none; }
.od-step.done::before { background: #8fbf6f; }
.od-step-dot {
  position: relative;
  z-index: 1;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #e0d4bd;
}
.od-step.done .od-step-dot { background: #5aa15a; }
.od-step.current .od-step-dot {
  background: #167a61;
  box-shadow: 0 0 0 6rpx rgba(22, 122, 97, 0.16);
}
.od-step-label {
  font-size: 22rpx;
  color: var(--muted);
}
.od-step.done .od-step-label,
.od-step.current .od-step-label {
  color: var(--text);
  font-weight: 600;
}

/* 物流时间线 */
.od-timeline {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
}
.od-tl-node {
  position: relative;
  padding: 0 0 24rpx 32rpx;
  border-left: 2rpx solid #e8ddca;
}
.od-tl-node:last-child { border-left-color: transparent; padding-bottom: 0; }
.od-tl-dot {
  position: absolute;
  left: -9rpx;
  top: 4rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #c9bca3;
}
.od-tl-node.latest .od-tl-dot { background: #167a61; }
.od-tl-body { display: flex; flex-direction: column; gap: 4rpx; }
.od-tl-context { font-size: 25rpx; color: var(--text); line-height: 1.4; }
.od-tl-node.latest .od-tl-context { color: #167a61; font-weight: 600; }
.od-tl-time { font-size: 22rpx; color: var(--muted); }

.od-card {
  margin-top: 20rpx;
  background: var(--paper);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.06);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.od-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
}

.od-track-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.od-track-company {
  font-size: 24rpx;
  color: #fff;
  background: var(--blue, #2e78b7);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.od-track-no {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  font-family: ui-monospace, Menlo, monospace;
  word-break: break-all;
}

.od-track-copy {
  margin-top: 16rpx;
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 16rpx 0;
}

.od-track-copy::after { border: none; }

.od-track-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.5;
}

.od-addr-main {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.od-addr-sub {
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.5;
}

.od-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed var(--line);
}

.od-item:last-of-type {
  border-bottom: none;
}

.od-item-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  background: var(--paper-soft);
  flex-shrink: 0;
}

.od-item-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.od-item-title {
  font-size: 26rpx;
  color: var(--text);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.od-item-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.od-item-cards {
  font-size: 24rpx;
  color: var(--red);
  font-weight: 600;
}

.od-item-qty {
  font-size: 24rpx;
  color: var(--muted);
}

.od-total {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-top: 18rpx;
  margin-top: 6rpx;
  border-top: 1rpx solid var(--line);
  font-size: 26rpx;
  color: var(--muted);
}

.od-total-num {
  font-size: 32rpx;
  color: var(--red);
  font-weight: 700;
}

.od-remark {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.6;
  white-space: pre-wrap;
}

.od-meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed var(--line);
}

.od-meta-row:last-of-type { border-bottom: none; }

.od-meta-label {
  flex: 0 0 130rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.od-meta-value {
  flex: 1;
  font-size: 24rpx;
  color: var(--text);
  word-break: break-all;
}

.od-meta-copy {
  font-size: 24rpx;
  color: var(--red);
}

.od-cta {
  margin-top: 32rpx;
}

.od-cta-secondary {
  margin-top: 16rpx;
  background: var(--paper);
  color: var(--text);
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 22rpx 0;
  border: 1rpx solid var(--line);
}

.od-cta-secondary::after { border: none; }

.od-reviewed-tip {
  margin-top: 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--green, #167a61);
  font-weight: 600;
}

.bottom-spacer {
  height: 60rpx;
}
