<view class="page-shell order-detail-page">
  <view class="loading-state" wx:if="{{loading}}">加载中…</view>

  <block wx:elif="{{order}}">
    <view class="od-status-card">
      <text class="od-status-label status-{{statusCode}}">{{statusLabel}}</text>
      <text class="od-status-desc">{{statusDesc}}</text>
      <text class="od-status-signed" wx:if="{{statusCode === 'signed' && signedText}}">签收时间：{{signedText}}{{signedBy ? '（' + signedBy + '）' : ''}}</text>
    </view>

    <!-- 进度步骤条（已取消不展示） -->
    <view class="od-steps" wx:if="{{!isCancelled}}">
      <view class="od-step {{item.done ? 'done' : ''}} {{item.current ? 'current' : ''}}" wx:for="{{steps}}" wx:key="label">
        <view class="od-step-dot"></view>
        <text class="od-step-label">{{item.label}}</text>
      </view>
    </view>

    <!-- 物流信息：有节点显时间线；否则有单号显单号+复制 -->
    <view class="od-card od-track-card" wx:if="{{nodes.length || order.trackingNo}}">
      <text class="od-card-title">物流信息</text>
      <view class="od-track-line" wx:if="{{order.trackingNo}}">
        <text class="od-track-company">{{order.trackingCompany || '快递'}}</text>
        <text class="od-track-no">{{order.trackingNo}}</text>
      </view>

      <view class="od-timeline" wx:if="{{nodes.length}}">
        <view class="od-tl-node {{index === 0 ? 'latest' : ''}}" wx:for="{{nodes}}" wx:key="time">
          <view class="od-tl-dot"></view>
          <view class="od-tl-body">
            <text class="od-tl-context">{{item.context}}</text>
            <text class="od-tl-time">{{item.time}}</text>
          </view>
        </view>
      </view>

      <block wx:if="{{order.trackingNo}}">
        <button class="od-track-copy" bindtap="copyTracking">复制单号去查物流</button>
        <text class="od-track-tip" wx:if="{{!nodes.length}}">复制后可在微信「我-服务」或快递100 / 菜鸟等查询轨迹</text>
      </block>
    </view>

    <view class="od-card">
      <text class="od-card-title">收货信息</text>
      <text class="od-addr-main">{{order.address.recipient}}　{{order.address.phone}}</text>
      <text class="od-addr-sub">{{order.address.province}} {{order.address.city}} {{order.address.district}} {{order.address.detail}}</text>
    </view>

    <view class="od-card">
      <text class="od-card-title">礼品 ({{order.items.length}})</text>
      <view class="od-item" wx:for="{{order.items}}" wx:key="productId">
        <image class="od-item-img" src="{{item.imageUrl}}" mode="aspectFill" lazy-load />
        <view class="od-item-body">
          <text class="od-item-title">{{item.title}}</text>
          <view class="od-item-meta">
            <text class="od-item-cards" wx:if="{{item.cardsNeeded > 0}}">{{item.cardsNeeded}} 积分</text>
            <text class="od-item-qty">× {{item.qty}}</text>
          </view>
        </view>
      </view>
      <view class="od-total" wx:if="{{order.totalCards > 0}}">
        <text>合计积分</text>
        <text class="od-total-num">{{order.totalCards}} 分</text>
      </view>
    </view>

    <view class="od-card" wx:if="{{order.remark}}">
      <text class="od-card-title">备注</text>
      <text class="od-remark">{{order.remark}}</text>
    </view>

    <view class="od-card">
      <view class="od-meta-row" bindtap="copyOrderId">
        <text class="od-meta-label">订单号</text>
        <text class="od-meta-value">{{order._id}}</text>
        <text class="od-meta-copy">复制</text>
      </view>
      <view class="od-meta-row">
        <text class="od-meta-label">提交时间</text>
        <text class="od-meta-value">{{createdText}}</text>
      </view>
    </view>

    <button class="od-cta-secondary" bindtap="contactService">联系客服跟进</button>
  </block>

  <view class="bottom-spacer"></view>
</view>
