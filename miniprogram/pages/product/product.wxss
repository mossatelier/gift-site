.product-page {
  padding: 0 0 40rpx;
}

.image-swiper-wrap {
  position: relative;
  background: var(--paper-soft);
  margin: 20rpx 24rpx 0;
  border-radius: 22rpx;
  overflow: hidden;
  border: 1rpx solid rgba(234, 223, 206, 0.9);
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.08);
}

.image-swiper {
  width: 100%;
  height: 700rpx;
}

.product-detail-image {
  width: 100%;
  height: 100%;
}

.image-indicator {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(29, 27, 24, 0.55);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.heart-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 18rpx rgba(46, 35, 18, 0.18);
}

.heart-svg {
  width: 42rpx;
  height: 42rpx;
}

/* 缩略图条 */
.thumb-strip {
  margin: 16rpx 24rpx 0;
  padding: 8rpx 0;
  white-space: nowrap;
}

.thumb-item {
  display: inline-block;
  width: 120rpx;
  height: 120rpx;
  margin-right: 14rpx;
  border-radius: 14rpx;
  overflow: hidden;
  border: 2rpx solid rgba(234, 223, 206, 0.9);
  background: var(--paper-soft);
  vertical-align: middle;
}

.thumb-item.active {
  border-color: var(--red);
  box-shadow: 0 0 0 2rpx rgba(214, 75, 42, 0.18);
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.product-detail-card {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(234, 223, 206, 0.9);
  margin: 20rpx 24rpx 0;
  border-radius: 22rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.08);
}

.product-detail-taghead {
  margin-bottom: 12rpx;
}

.product-detail-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text);
  display: block;
  line-height: 1.4;
}

.product-detail-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
  gap: 22rpx;
}

.product-detail-points {
  color: var(--red);
  font-size: 36rpx;
  font-weight: 800;
}

.product-detail-price {
  color: var(--muted);
  font-size: 24rpx;
}

.product-detail-views {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.product-detail-tags {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.product-tag {
  font-size: 22rpx;
  color: var(--red);
  background: rgba(214, 75, 42, 0.1);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.points-rule-btn {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 22rpx;
  background: linear-gradient(135deg, #fff7e3 0%, #fff2d2 100%);
  border: 1rpx solid rgba(224, 172, 77, 0.5);
  border-radius: 16rpx;
}

.points-rule-icon {
  font-size: 30rpx;
}

.points-rule-text {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  color: #8a5a14;
}

.points-rule-arrow {
  font-size: 34rpx;
  color: var(--gold);
}

.section-mini-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text);
  display: block;
  margin-bottom: 10rpx;
}

.product-description {
  font-size: 26rpx;
  color: #5d5140;
  display: block;
  white-space: pre-wrap;
  line-height: 1.7;
}

.contact-card {
  background: linear-gradient(160deg, #fff7e3 0%, #fff2d2 100%);
  border: 1rpx solid rgba(224, 172, 77, 0.45);
  margin: 24rpx;
  border-radius: 26rpx;
  padding: 36rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: center;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.08);
}

.contact-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text);
}

.contact-tip {
  font-size: 24rpx;
  color: #5d5140;
}

.contact-card .primary-btn {
  width: 80%;
  margin-top: 12rpx;
}

.bottom-spacer {
  height: 32rpx;
}

/* 二维码弹层（与首页一致） */
.qr-mask {
  position: fixed;
  inset: 0;
  background: rgba(29, 27, 24, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.qr-card {
  background: var(--paper);
  border-radius: 28rpx;
  padding: 40rpx 32rpx 32rpx;
  width: 560rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 16rpx 40rpx rgba(46, 35, 18, 0.18);
}

.qr-title {
  font-size: 30rpx;
  font-weight: 800;
}

.qr-image {
  width: 400rpx;
  height: 400rpx;
  background: var(--paper-soft);
}

.qr-tip {
  font-size: 22rpx;
  color: var(--muted);
}

.qr-close {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--red);
  padding: 12rpx 36rpx;
  border: 1rpx solid var(--red);
  border-radius: 999rpx;
}

/* 兑换操作区：并排两按钮 */
.cta-row {
  display: flex;
  gap: 18rpx;
  width: 100%;
  margin-top: 8rpx;
}
.cta-btn {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 999rpx;
  padding: 20rpx 0;
  line-height: 1.3;
}
.cta-btn::after { border: none; }
.cta-btn-kefu {
  background: linear-gradient(135deg, #e8722e 0%, #d64b2a 100%);
  color: #fff;
}
.cta-btn-submit {
  background: #fff;
  color: var(--red);
  border: 2rpx solid var(--red);
}
.cta-note {
  font-size: 22rpx;
  color: #8a7c66;
  text-align: center;
  margin-top: 4rpx;
}

/* 收藏并提交地址 弹层 */
.submit-mask {
  position: fixed;
  inset: 0;
  background: rgba(29, 27, 24, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
}
.submit-card {
  background: var(--paper);
  border-radius: 28rpx;
  padding: 36rpx 32rpx 32rpx;
  width: 100%;
  max-width: 620rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  box-shadow: 0 16rpx 40rpx rgba(46, 35, 18, 0.18);
}
.submit-title {
  font-size: 32rpx;
  font-weight: 800;
  text-align: center;
}
.submit-gift {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: var(--paper-soft);
  border-radius: 18rpx;
  padding: 16rpx;
}
.submit-gift-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  flex: 0 0 auto;
  background: #eee;
}
.submit-gift-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  flex: 1;
}
.submit-addr {
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.submit-addr-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.submit-addr-name { font-size: 28rpx; font-weight: 700; }
.submit-addr-change { font-size: 24rpx; color: var(--red); }
.submit-addr-detail { font-size: 24rpx; color: #5d5140; }
.submit-addr-empty {
  border: 1rpx dashed var(--red);
  border-radius: 18rpx;
  padding: 28rpx;
  text-align: center;
  color: var(--red);
  font-size: 28rpx;
  font-weight: 700;
}
.submit-remark {
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 20rpx;
  height: 140rpx;
  font-size: 26rpx;
  background: #fff;
  width: 100%;
  box-sizing: border-box;
}
.submit-note {
  font-size: 22rpx;
  color: #8a7c66;
  line-height: 1.5;
}
.submit-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 4rpx;
}
.submit-cancel, .submit-ok {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 999rpx;
  padding: 20rpx 0;
}
.submit-cancel::after, .submit-ok::after { border: none; }
.submit-cancel {
  background: #fff;
  color: #5d5140;
  border: 1rpx solid var(--line);
}
.submit-ok {
  background: linear-gradient(135deg, #e8722e 0%, #d64b2a 100%);
  color: #fff;
}

.submit-result-banner {
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(214, 75, 42, 0.08);
  border: 2rpx solid rgba(214, 75, 42, 0.28);
  color: #d64b2a;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}
.submit-result-actions { margin-top: 10rpx; }
.submit-result-link {
  display: inline-block;
  font-size: 24rpx;
  font-weight: 800;
  color: #d64b2a;
  text-decoration: underline;
}
