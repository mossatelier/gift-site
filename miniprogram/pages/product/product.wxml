<block wx:if="{{loading}}">
  <view class="loading-state">加载中…</view>
</block>

<block wx:elif="{{!product}}">
  <view class="empty-state">商品不存在或已下架</view>
</block>

<view wx:else class="page-shell product-page">
  <!-- 图片轮播 + 心愿单按钮 -->
  <view class="image-swiper-wrap">
    <swiper
      class="image-swiper"
      indicator-dots="{{product.images.length > 1}}"
      autoplay="{{false}}"
      circular
      current="{{currentImageIndex}}"
      bindchange="onImageChange"
      indicator-color="rgba(255,255,255,0.4)"
      indicator-active-color="#fff"
    >
      <swiper-item
        wx:for="{{product.images}}"
        wx:key="*this"
      >
        <image
          class="product-detail-image"
          src="{{item}}"
          mode="aspectFill"
          bindtap="previewImage"
          data-index="{{index}}"
        />
      </swiper-item>
    </swiper>
    <view class="image-indicator" wx:if="{{product.images.length > 1}}">
      {{currentImageIndex + 1}} / {{product.images.length}}
    </view>
    <view class="heart-btn {{wishlisted ? 'active' : ''}}" bindtap="toggleWishlist">
      <image src="{{wishlisted ? '/images/icons/heart-filled.svg' : '/images/icons/heart.svg'}}" mode="aspectFit" class="heart-svg" />
    </view>
  </view>

  <!-- 缩略图 gallery -->
  <scroll-view
    class="thumb-strip"
    scroll-x
    enable-flex
    wx:if="{{product.images.length > 1}}"
  >
    <view
      class="thumb-item {{currentImageIndex === index ? 'active' : ''}}"
      wx:for="{{product.images}}"
      wx:key="*this"
      data-index="{{index}}"
      bindtap="onThumbTap"
    >
      <image class="thumb-img" src="{{item}}" mode="aspectFill" lazy-load></image>
    </view>
  </scroll-view>

  <!-- 商品信息卡 -->
  <view class="product-detail-card">
    <text class="product-detail-title">{{product.title}}</text>
    <view class="product-detail-meta">
      <text class="product-detail-points" wx:if="{{product.cardsNeeded > 0}}">兑换积分：{{product.cardsNeeded}} 分</text>
      <text class="product-detail-price">参考价 ¥{{product.price}}</text>
    </view>
    <view class="product-detail-views">👁 浏览 {{product.viewCount}} 次</view>
    <view class="product-detail-tags">
      <text class="product-tag" wx:if="{{categoryLabel}}">{{categoryLabel}}</text>
      <text class="product-tag" wx:if="{{product.subcategory}}">{{product.subcategory}}</text>
    </view>
  </view>

  <!-- 套餐描述 -->
  <view class="product-detail-card" wx:if="{{product.description}}">
    <text class="section-mini-title">套餐包含 / 详情</text>
    <text class="product-description">{{product.description}}</text>
  </view>

  <!-- 客服引导 -->
  <view class="contact-card">
    <text class="contact-title">想兑换这个礼品？</text>
    <text class="contact-tip">联系客服微信，免费办卡即可领取</text>
    <button class="primary-btn" bindtap="showQrcode">添加客服微信</button>
  </view>

  <view class="bottom-spacer"></view>

  <!-- 二维码弹层 -->
  <view class="qr-mask" wx:if="{{showQr}}" bindtap="hideQrcode">
    <view class="qr-card" catchtap="">
      <text class="qr-title">添加客服微信</text>
      <image class="qr-image" src="/images/wechat-qr.jpg" mode="aspectFit"></image>
      <text class="qr-tip">长按二维码 → 识别图中二维码</text>
      <view class="qr-close" bindtap="hideQrcode">关闭</view>
    </view>
  </view>
</view>
