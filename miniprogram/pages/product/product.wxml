<block wx:if="{{loading}}">
  <view class="loading-state">加载中…</view>
</block>

<block wx:elif="{{!product}}">
  <view class="empty-state">商品不存在或已下架</view>
</block>

<view wx:else class="page-shell product-page">
  <!-- 图片轮播 + 心愿单按钮 -->
  <view class="image-swiper-wrap">
    <swiper
      class="image-swiper"
      indicator-dots="{{product.images.length > 1}}"
      autoplay="{{false}}"
      circular
      current="{{currentImageIndex}}"
      bindchange="onImageChange"
      indicator-color="rgba(255,255,255,0.4)"
      indicator-active-color="#fff"
    >
      <swiper-item
        wx:for="{{product.images}}"
        wx:key="*this"
      >
        <image
          class="product-detail-image"
          src="{{item}}"
          mode="aspectFill"
          bindtap="previewImage"
          data-index="{{index}}"
        />
      </swiper-item>
    </swiper>
    <view class="image-indicator" wx:if="{{product.images.length > 1}}">
      {{currentImageIndex + 1}} / {{product.images.length}}
    </view>
    <view class="heart-btn {{wishlisted ? 'active' : ''}}" bindtap="toggleWishlist">
      <image src="{{wishlisted ? '/images/icons/heart-filled.svg' : '/images/icons/heart.svg'}}" mode="aspectFit" class="heart-svg" />
    </view>
  </view>

  <!-- 缩略图 gallery -->
  <scroll-view
    class="thumb-strip"
    scroll-x
    enable-flex
    wx:if="{{product.images.length > 1}}"
  >
    <view
      class="thumb-item {{currentImageIndex === index ? 'active' : ''}}"
      wx:for="{{product.images}}"
      wx:key="*this"
      data-index="{{index}}"
      bindtap="onThumbTap"
    >
      <image class="thumb-img" src="{{item}}" mode="aspectFill" lazy-load></image>
    </view>
  </scroll-view>

  <!-- 商品信息卡 -->
  <view class="product-detail-card">
    <view class="product-detail-taghead">
      <text class="title-tag {{product.category === 'referral' ? 'title-tag-referral' : 'title-tag-card'}}">{{product.category === 'referral' ? '推荐可兑' : '办卡可兑'}}</text>
    </view>
    <text class="product-detail-title">{{product.title}}</text>
    <view class="product-detail-meta">
      <text class="product-detail-points" wx:if="{{pointsText}}">{{pointsText}}</text>
      <text class="product-detail-price">参考价 ¥{{product.price}}</text>
    </view>
    <view class="product-detail-views">👁 浏览 {{product.viewCount}} 次</view>
    <view class="product-detail-tags">
      <text class="product-tag" wx:if="{{categoryLabel}}">{{categoryLabel}}</text>
      <text class="product-tag" wx:if="{{product.subcategory}}">{{product.subcategory}}</text>
    </view>
    <view class="points-rule-btn" bindtap="goEarn">
      <text class="points-rule-icon">📋</text>
      <text class="points-rule-text">本月积分获得规则</text>
      <text class="points-rule-arrow">›</text>
    </view>
  </view>

  <!-- 套餐描述 -->
  <view class="product-detail-card" wx:if="{{product.description}}">
    <text class="section-mini-title">套餐包含 / 详情</text>
    <text class="product-description">{{product.description}}</text>
  </view>

  <!-- 兑换操作区：左加客服 / 右收藏并提交地址（两个按钮一直都在，客户自己选） -->
  <view class="contact-card">
    <text class="contact-title">想兑换这个礼品？</text>
    <view class="cta-row">
      <button class="cta-btn cta-btn-kefu" bindtap="showQrcode">添加客服微信</button>
      <button class="cta-btn cta-btn-submit" bindtap="openSubmit">收藏并提交地址</button>
    </view>
    <text class="cta-note">提交地址后，请微信同步客服，核验订单后发货</text>
  </view>

  <view class="bottom-spacer"></view>

  <!-- 收藏并提交地址 弹层 -->
  <view class="submit-mask" wx:if="{{showSubmit}}" bindtap="closeSubmit">
    <view class="submit-card" catchtap="noop">
      <text class="submit-title">提交兑换申请</text>

      <view class="submit-gift">
        <image class="submit-gift-img" src="{{product.imageUrl}}" mode="aspectFill" />
        <text class="submit-gift-name">{{product.title}}</text>
      </view>

      <view class="submit-addr" wx:if="{{submitAddress}}" bindtap="goSubmitAddress">
        <view class="submit-addr-main">
          <text class="submit-addr-name">{{submitAddress.recipient}} {{submitAddress.phone}}</text>
          <text class="submit-addr-change">更换 ›</text>
        </view>
        <text class="submit-addr-detail">{{submitAddress.province}}{{submitAddress.city}}{{submitAddress.district}}{{submitAddress.detail}}</text>
      </view>
      <view class="submit-addr-empty" wx:else bindtap="goSubmitAddress">
        <text>＋ 填写收货地址</text>
      </view>

      <textarea class="submit-remark" value="{{submitRemark}}" bindinput="onRemarkInput" placeholder="备注（必填）：颜色 / 规格 / 想办的银行等" maxlength="200" />

      <text class="submit-note">提交后信息会自动复制，请粘贴发给客服微信核验，核验后发货。</text>

      <view class="submit-actions">
        <button class="submit-cancel" bindtap="closeSubmit">取消</button>
        <button class="submit-ok" loading="{{submitting}}" bindtap="confirmSubmit">提交并复制给客服</button>
      </view>
    </view>
  </view>

  <!-- 二维码弹层 -->
  <view class="qr-mask" wx:if="{{showQr}}" bindtap="hideQrcode">
    <view class="qr-card" catchtap="">
      <text class="qr-title">添加客服微信</text>
      <image class="qr-image" src="/images/wechat-qr.jpg" mode="aspectFit"></image>
      <text class="qr-tip">长按二维码 → 识别图中二维码</text>
      <view class="qr-close" bindtap="hideQrcode">关闭</view>
    </view>
  </view>
</view>
