<view class="page-shell progress-page">
  <view class="section">
    <view class="section-banner">
      <text class="banner-title-text">银行办卡进度查询</text>
    </view>

    <view class="bank-table">
      <text class="bank-intro">点「查看二维码」展开 → 保存二维码 → 打开微信「扫一扫」选相册里的二维码，即可跳转官方进度查询。</text>

      <view class="bank-list">
        <view class="bank-card" wx:for="{{banks}}" wx:key="key">
          <view
            class="bank-item"
            data-key="{{item.key}}"
            bindtap="toggleQr"
          >
            <view class="bank-left">
              <image class="bank-logo" src="{{item.logo}}" mode="aspectFit"></image>
              <text class="bank-name">{{item.name}}</text>
            </view>
            <text class="bank-arrow">{{openKey === item.key ? '收起 ▴' : '查看二维码 ›'}}</text>
          </view>

          <block wx:if="{{openKey === item.key}}">
            <view class="bank-qr-wrap">
              <image class="bank-qr" src="{{item.qr}}" mode="aspectFit" data-qr="{{item.qr}}" bindtap="previewQr"></image>
              <text class="bank-qr-tip">保存后用微信「扫一扫」选相册识别</text>
              <view class="bank-qr-save" data-qr="{{item.qr}}" data-name="{{item.name}}" bindtap="saveQr">⬇ 保存二维码</view>
            </view>

            <view
              wx:if="{{item.url}}"
              class="bank-copy"
              data-url="{{item.url}}"
              data-name="{{item.name}}"
              bindtap="copyUrl"
            >复制查询链接（也可用）›</view>
          </block>
        </view>
      </view>

      <text class="bank-tip">如二维码无法识别，请联系客服微信 <text class="bank-tip-strong">L1916959</text>。</text>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</view>
