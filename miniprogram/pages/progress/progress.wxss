.progress-page {
  padding: 16rpx 24rpx 60rpx;
}

.bank-table {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(234, 223, 206, 0.9);
  border-radius: 22rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.08);
}

.bank-intro {
  font-size: 26rpx;
  color: var(--text);
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.bank-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.bank-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  background: var(--paper-soft);
  border: 1rpx solid rgba(234, 223, 206, 0.7);
  border-radius: 16rpx;
}

.bank-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  flex: 1;
}

.bank-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 14rpx;
  background: #fff;
  flex: 0 0 auto;
}

.bank-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.bank-arrow {
  font-size: 24rpx;
  color: var(--red);
  font-weight: 700;
  flex: 0 0 auto;
}

.bank-tip {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.6;
}

.bank-tip-strong {
  color: var(--red);
  font-weight: 700;
}

.bottom-spacer {
  height: 32rpx;
}
