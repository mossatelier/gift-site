.earn-page {
  padding: 16rpx 24rpx 60rpx;
}

.bank-table {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(234, 223, 206, 0.9);
  border-radius: 22rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.08);
}

.bank-intro {
  font-size: 26rpx;
  color: var(--text);
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.bank-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.bank-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  background: var(--paper-soft);
  border: 1rpx solid rgba(234, 223, 206, 0.7);
  border-radius: 16rpx;
}

.bank-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.bank-points {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--red);
}

.bank-tip {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.6;
}

.bottom-spacer {
  height: 32rpx;
}
