.category-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* 顶部搜索栏 */
.category-search {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: rgba(255, 250, 243, 0.96);
  border-bottom: 1rpx solid rgba(234, 223, 206, 0.9);
}

.category-search-input {
  flex: 1;
  min-width: 0;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(234, 223, 206, 0.9);
  border-radius: 28rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 35, 18, 0.06);
}

.category-search-btn {
  flex: 0 0 auto;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  border-radius: 22rpx;
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  box-shadow: 0 8rpx 16rpx rgba(214, 75, 42, 0.22);
}

.category-body {
  flex: 1;
  display: flex;
  min-height: 0;
}

.category-left {
  width: 200rpx;
  background: rgba(255, 250, 243, 0.96);
  height: 100%;
  border-right: 1rpx solid rgba(234, 223, 206, 0.8);
}

.category-left-item {
  padding: 28rpx 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--muted);
  text-align: center;
  position: relative;
}

.category-left-item.active {
  color: var(--red);
  background: var(--bg);
}

.category-left-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: var(--red);
  border-radius: 0 4rpx 4rpx 0;
}

.category-right {
  flex: 1;
  padding: 20rpx 18rpx 120rpx;
  box-sizing: border-box;
}

/* 当前分类标题 + 查看全部 */
.category-title-bar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 4rpx 4rpx 16rpx;
}

.category-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text);
}

.category-more {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--red);
}

.subcategory-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 8rpx 0 20rpx;
}

.sub-chip {
  background: rgba(255, 255, 255, 0.92);
  color: var(--text);
  font-size: 22rpx;
  font-weight: 700;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(234, 223, 206, 0.9);
}

.sub-chip.active {
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 6rpx 14rpx rgba(214, 75, 42, 0.22);
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.product-card {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(234, 223, 206, 0.9);
  border-radius: 22rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.08);
  display: flex;
  flex-direction: column;
}

.product-media {
  position: relative;
  aspect-ratio: 1 / 1;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-body {
  padding: 16rpx 14rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.product-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-meta {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--red);
}
