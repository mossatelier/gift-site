<view class="home-page">
  <!-- 顶部品牌 + 搜索框（粘性） -->
  <view class="top-bar top-bar-search">
    <text class="brand">🏠 加加好物图集</text>
    <view class="search-box top-search">
      <input
        class="search-input"
        type="text"
        placeholder="搜索礼品"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        confirm-type="search"
        bindconfirm="onSearchSubmit"
      />
      <view class="search-btn" bindtap="onSearchSubmit">搜</view>
    </view>
  </view>

  <!-- 轮播：优先后台配置的海报；无配置时回退默认两张 -->
  <view class="banner-wrap">
    <swiper class="banner-swiper" indicator-dots autoplay interval="4500" duration="500" circular indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#fff">
      <block wx:if="{{banners.length}}">
        <swiper-item wx:for="{{banners}}" wx:key="index">
          <image
            class="banner-image"
            src="{{item.imageUrl}}"
            mode="aspectFill"
            data-link-type="{{item.linkType}}"
            data-link-value="{{item.linkValue}}"
            bindtap="onBannerTap"
          ></image>
        </swiper-item>
      </block>
      <block wx:else>
        <swiper-item>
          <image class="banner-image" src="/images/banners/promo-1.jpg" mode="aspectFill" bindtap="goWishlist"></image>
        </swiper-item>
        <swiper-item>
          <image class="banner-image" src="/images/banners/promo-2.jpg" mode="aspectFill" bindtap="goEarn"></image>
        </swiper-item>
      </block>
    </swiper>
  </view>

  <!-- 主入口（一排五个圆圈） -->
  <view class="home-circles">
    <view class="circle-item" bindtap="goCardFlow">
      <view class="circle-badge circle-badge-red">
        <image src="/images/icons/hc-cardflow.svg" mode="aspectFit" class="circle-svg" />
      </view>
      <text class="circle-label">办卡流程</text>
    </view>
    <view class="circle-item" bindtap="goEarn">
      <view class="circle-badge circle-badge-gold">
        <image src="/images/icons/earn.svg" mode="aspectFit" class="circle-svg" />
      </view>
      <text class="circle-label">获取积分</text>
    </view>
    <view class="circle-item" bindtap="goProgress">
      <view class="circle-badge circle-badge-teal">
        <image src="/images/icons/progress.svg" mode="aspectFit" class="circle-svg" />
      </view>
      <text class="circle-label">进度查询</text>
    </view>
    <view class="circle-item" bindtap="goClaimGuide">
      <view class="circle-badge circle-badge-pink">
        <image src="/images/icons/hc-claim.svg" mode="aspectFit" class="circle-svg" />
      </view>
      <text class="circle-label">领取须知</text>
    </view>
    <view class="circle-item" bindtap="goBankNewUser">
      <view class="circle-badge circle-badge-blue">
        <image src="/images/icons/hc-bank.svg" mode="aspectFit" class="circle-svg" />
      </view>
      <text class="circle-label">银行新户</text>
    </view>
  </view>

  <!-- 积分快捷跳转栏（图标区下方、热门兑换上方）：每个按钮上行积分档、下行对应银行 -->
  <view class="points-quick">
    <view class="points-quick-head">
      <text class="points-quick-title">按积分快速兑换</text>
      <text class="points-quick-sub">点击档位筛选对应银行礼品</text>
    </view>
    <view class="points-quick-row">
      <view
        class="points-quick-btn"
        wx:for="{{cardsQuick}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="goCardsList"
      >
        <text class="pq-points">{{item.label}}</text>
        <text class="pq-bank" wx:if="{{item.bank}}">{{item.bank}}</text>
      </view>
    </view>
  </view>

  <!-- 热门兑换 -->
  <view class="section">
    <view class="section-banner">
      <text class="banner-title-text">热门兑换</text>
      <text class="banner-more" bindtap="goList">更多 ›</text>
    </view>
    <block wx:if="{{loading}}">
      <view class="loading-state">加载中…</view>
    </block>
    <block wx:elif="{{hotList.length === 0}}">
      <view class="empty-state">还没有商品，请到后台录入</view>
    </block>
    <view wx:else class="product-grid product-grid-2">
      <view
        class="product-card"
        wx:for="{{hotList}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bindtap="goProduct"
      >
        <view class="product-media">
          <image class="product-image" src="{{item.imageUrl}}" mode="aspectFill" lazy-load></image>
          <view class="card-heart-btn" catchtap="toggleHeart" data-id="{{item._id}}">
            <image src="{{wishlistMap[item._id] ? '/images/icons/heart-filled.svg' : '/images/icons/heart.svg'}}" mode="aspectFit" class="card-heart-svg" />
          </view>
        </view>
        <view class="product-body">
          <text class="product-title"><text class="title-tag {{item.category === 'referral' ? 'title-tag-referral' : 'title-tag-card'}}">{{item.category === 'referral' ? '邀请可兑' : '办卡可兑'}}</text>{{item.title}}</text>
          <text class="product-meta" wx:if="{{item.cardsNeeded > 0}}">兑换积分：{{item.cardsNeeded}} 分</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 新品速递 -->
  <view class="section">
    <view class="section-banner">
      <text class="banner-title-text">新品速递</text>
      <text class="banner-more" bindtap="goListNewest">更多 ›</text>
    </view>
    <block wx:if="{{loading}}">
      <view class="loading-state">加载中…</view>
    </block>
    <block wx:elif="{{newList.length === 0}}">
      <view class="empty-state">暂无新品</view>
    </block>
    <view wx:else class="product-grid product-grid-2">
      <view
        class="product-card"
        wx:for="{{newList}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bindtap="goProduct"
      >
        <view class="product-media">
          <image class="product-image" src="{{item.imageUrl}}" mode="aspectFill" lazy-load></image>
          <view class="card-heart-btn" catchtap="toggleHeart" data-id="{{item._id}}">
            <image src="{{wishlistMap[item._id] ? '/images/icons/heart-filled.svg' : '/images/icons/heart.svg'}}" mode="aspectFit" class="card-heart-svg" />
          </view>
        </view>
        <view class="product-body">
          <text class="product-title"><text class="title-tag {{item.category === 'referral' ? 'title-tag-referral' : 'title-tag-card'}}">{{item.category === 'referral' ? '邀请可兑' : '办卡可兑'}}</text>{{item.title}}</text>
          <text class="product-meta" wx:if="{{item.cardsNeeded > 0}}">兑换积分：{{item.cardsNeeded}} 分</text>
        </view>
      </view>
    </view>
  </view>


  <!-- 公告 -->
  <view class="announce">
    <text class="announce-title">加加好物图集</text>
    <text class="announce-item">所有礼品均为正品，活动真实有效，可按专区查看。</text>
    <text class="announce-item">礼品持续上新，页面内容会同步更新。</text>
  </view>

  <!-- 常见问题 -->
  <view class="section">
    <view class="section-banner">
      <text class="banner-title-text">常见问题</text>
    </view>
    <view class="faq-list">
      <view class="faq-item">
        <text class="faq-question">Q1：怎么参与活动？</text>
        <text class="faq-answer">联系客服微信即可，所有活动都是真实免费办卡。</text>
      </view>
      <view class="faq-item">
        <text class="faq-question">Q2：礼品什么时候发？</text>
        <text class="faq-answer">通常下卡后 3 个工作日内安排发货，详见活动说明。</text>
      </view>
      <view class="faq-item">
        <text class="faq-question">Q3：怎么查询新户？</text>
        <text class="faq-answer">直接联系客服核验，确认无误后再办理。</text>
      </view>
    </view>
  </view>

  <view class="bottom-spacer"></view>

  <!-- 咨询：可拖动 -->
  <view class="float-btn float-btn-primary float-chat" style="{{floatStyle}}"
    catchtouchmove="onFloatMove" bindtouchend="onFloatEnd" bindtap="floatService">
    <text class="float-emoji">💬</text>
    <text class="float-label">咨询</text>
  </view>
  <!-- 返回顶部：滚动超半屏才显示 -->
  <view class="float-btn float-top-btn {{showBackTop ? '' : 'hide'}}" bindtap="backToTop">
    <text class="float-top">↑</text>
    <text class="float-label">顶部</text>
  </view>

  <!-- 二维码弹层 -->
  <view class="qr-mask" wx:if="{{showQr}}" bindtap="hideQrcode">
    <view class="qr-card" catchtap="">
      <text class="qr-title">添加客服微信</text>
      <image class="qr-image" src="/images/wechat-qr.jpg" mode="aspectFit"></image>
      <text class="qr-tip">长按二维码 → 识别图中二维码</text>
      <view class="qr-close" bindtap="hideQrcode">关闭</view>
    </view>
  </view>
</view>
