.referral-page {
  padding: 24rpx;
}
.loading-state {
  text-align: center;
  color: var(--muted);
  padding: 80rpx 0;
}

/* 推荐码卡 */
.ref-code-card {
  background: linear-gradient(135deg, #ff8a3d 0%, #e8531f 100%);
  border-radius: 26rpx;
  padding: 40rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 12rpx 28rpx rgba(232, 83, 31, 0.28);
}
.ref-code-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}
.ref-code-value {
  font-size: 72rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 12rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
}
.ref-code-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 12rpx;
  width: 100%;
}
.ref-btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 999rpx;
  padding: 18rpx 0;
  line-height: 1.3;
  margin: 0;
}
.ref-btn::after { border: none; }
.ref-btn-ghost {
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}
.ref-btn-primary {
  background: #fff;
  color: #e8531f;
}

/* 数据 */
.ref-stats {
  display: flex;
  margin: 24rpx 0;
  background: var(--paper);
  border-radius: 22rpx;
  padding: 28rpx 0;
  box-shadow: var(--shadow);
}
.ref-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.ref-stat + .ref-stat {
  border-left: 1rpx solid var(--line);
}
.ref-stat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text);
}
.ref-stat-num-gold { color: #e8531f; }
.ref-stat-label {
  font-size: 22rpx;
  color: var(--muted);
}

/* 区块 */
.ref-section {
  background: var(--paper);
  border-radius: 22rpx;
  padding: 28rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}
.ref-section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 18rpx;
}

/* 规则 */
.ref-rule {
  display: flex;
  gap: 14rpx;
  margin-bottom: 14rpx;
}
.ref-rule-idx {
  flex: 0 0 auto;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(232, 83, 31, 0.12);
  color: #e8531f;
  font-size: 22rpx;
  font-weight: 800;
}
.ref-rule-text {
  flex: 1;
  font-size: 25rpx;
  color: #5d5140;
  line-height: 1.5;
}

/* 明细 */
.ref-empty {
  font-size: 25rpx;
  color: var(--muted);
  text-align: center;
  padding: 30rpx 0;
}
.ref-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.ref-item:last-child { border-bottom: none; }
.ref-item-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.ref-item-nick {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--text);
}
.ref-item-phone {
  font-size: 22rpx;
  color: var(--muted);
}
.ref-item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}
.ref-item-status {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--muted);
  background: var(--paper-soft);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}
.ref-status-ok {
  color: #1f9488;
  background: rgba(31, 148, 136, 0.12);
}
.ref-item-reward {
  font-size: 22rpx;
  font-weight: 800;
  color: #e8531f;
}
.ref-item-date {
  font-size: 20rpx;
  color: var(--muted);
}
