<view class="page-shell wishlist-page">
  <view class="section">
    <view class="section-banner">
      <text class="banner-title-text">我的心愿单</text>
      <text class="banner-more" wx:if="{{items.length > 0}}">共 {{items.length}} 件</text>
    </view>

    <!-- 空状态 -->
    <view class="wishlist-empty" wx:if="{{!loading && items.length === 0}}">
      <text class="wishlist-empty-icon">🎁</text>
      <text class="wishlist-empty-title">心愿单是空的</text>
      <text class="wishlist-empty-text">看到喜欢的礼物，点击心形图标收藏到这里</text>
      <view class="wishlist-cta" bindtap="goList">去选礼</view>
    </view>

    <view class="loading-state" wx:elif="{{loading}}">加载中…</view>

    <!-- 心愿网格 -->
    <view class="product-grid" wx:else>
      <view
        class="product-card"
        wx:for="{{items}}"
        wx:key="_id"
      >
        <view class="product-media" data-id="{{item._id}}" bindtap="goProduct">
          <image class="product-image" src="{{item.imageUrl}}" mode="aspectFill" lazy-load></image>
        </view>
        <view class="product-body" data-id="{{item._id}}" bindtap="goProduct">
          <text class="product-title">{{item.title}}</text>
          <text class="product-price" wx:if="{{item.price > 0}}">¥{{item.price}}</text>
          <text class="product-meta" wx:if="{{item.cardsNeeded > 0}}">兑换积分：{{item.cardsNeeded}} 分</text>
        </view>
        <view class="heart-btn active" catchtap="removeItem" data-id="{{item._id}}">
          <image src="/images/icons/heart-filled.svg" mode="aspectFit" class="heart-svg" />
        </view>
      </view>
    </view>
  </view>

  <!-- 客服联系卡 -->
  <view class="wishlist-contact">
    <text class="wishlist-contact-title">联系我</text>
    <view class="wishlist-qr" bindtap="previewQrcode">
      <image src="/images/wishlist-wechat-qr.jpg" mode="aspectFit" class="wishlist-qr-image"></image>
    </view>
    <text class="wishlist-wechat-id">客服微信：<text class="wishlist-wechat-id-strong">L1916959</text></text>
    <text class="wishlist-tip">点击放大，长按识别二维码或保存</text>
    <text class="wishlist-channels">💳 信用卡　💰 存款　📈 证券</text>
    <text class="wishlist-channels-tip">以上方式均可领取礼品</text>
  </view>

  <!-- 三个流程折叠 -->
  <view class="wishlist-flows">
    <view class="flow-card">
      <view class="flow-summary {{openFlow === 'credit' ? 'open' : ''}}" bindtap="toggleFlow" data-flow="credit">
        <text>信用卡流程</text>
        <text class="flow-chevron">{{openFlow === 'credit' ? '▴' : '▾'}}</text>
      </view>
      <view class="flow-body" wx:if="{{openFlow === 'credit'}}">
        <text class="flow-step">① 选择礼品并领取银行的推荐码</text>
        <text class="flow-step">② 提交申请资料</text>
        <text class="flow-step">③ 初审通过后 15 天内去银行网点激活并首刷</text>
        <text class="flow-step">④ 待首刷数据更新（约 2-3 个工作日）后发放礼品</text>
      </view>
    </view>

    <view class="flow-card">
      <view class="flow-summary {{openFlow === 'deposit' ? 'open' : ''}}" bindtap="toggleFlow" data-flow="deposit">
        <text>存款流程</text>
        <text class="flow-chevron">{{openFlow === 'deposit' ? '▴' : '▾'}}</text>
      </view>
      <view class="flow-body" wx:if="{{openFlow === 'deposit'}}">
        <text class="flow-step">① 选择礼品并联系推荐人</text>
        <text class="flow-step">② 扫码完成银行存款任务</text>
        <text class="flow-step">③ 存款达标后截图确认</text>
        <text class="flow-step">④ 联系推荐人，存款任务到期后发放礼品</text>
      </view>
    </view>

    <view class="flow-card">
      <view class="flow-summary {{openFlow === 'securities' ? 'open' : ''}}" bindtap="toggleFlow" data-flow="securities">
        <text>证券流程</text>
        <text class="flow-chevron">{{openFlow === 'securities' ? '▴' : '▾'}}</text>
      </view>
      <view class="flow-body" wx:if="{{openFlow === 'securities'}}">
        <text class="flow-step">① 选择礼品并联系推荐人</text>
        <text class="flow-step">② 扫码完成证券开户并入金</text>
        <text class="flow-step">③ 购买指定理财产品达标后截图确认</text>
        <text class="flow-step">④ 联系推荐人，证券任务到期后发送礼品</text>
      </view>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</view>
