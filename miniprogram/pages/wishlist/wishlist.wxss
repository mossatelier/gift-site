.wishlist-page {
  padding: 16rpx 24rpx 60rpx;
}

/* 空状态 */
.wishlist-empty {
  padding: 80rpx 28rpx 60rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(234, 223, 206, 0.9);
  border-radius: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.08);
}

.wishlist-empty-icon {
  font-size: 80rpx;
}

.wishlist-empty-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text);
}

.wishlist-empty-text {
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
}

.wishlist-cta {
  margin-top: 12rpx;
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  padding: 16rpx 44rpx;
  border-radius: 999rpx;
  box-shadow: 0 10rpx 20rpx rgba(214, 75, 42, 0.25);
}

/* 商品网格（与列表页一致） */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.product-card {
  position: relative;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(234, 223, 206, 0.9);
  border-radius: 22rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.08);
  display: flex;
  flex-direction: column;
}

.product-media {
  position: relative;
  aspect-ratio: 1 / 1;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-body {
  padding: 16rpx 14rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.product-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-price {
  font-size: 24rpx;
  color: var(--muted);
}

.product-meta {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--red);
}

/* 红心按钮（移除） */
.heart-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 14rpx rgba(46, 35, 18, 0.12);
}

.heart-svg {
  width: 38rpx;
  height: 38rpx;
}

/* 提交申请区 */
.wishlist-submit {
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(234, 223, 206, 0.9);
  border-radius: 22rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.08);
}

.submit-addr {
  background: var(--paper-soft);
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--line);
}

.submit-addr-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.submit-addr-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.submit-addr-action {
  font-size: 24rpx;
  color: var(--red);
}

.submit-addr-body {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.submit-addr-main {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.submit-addr-sub {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
}

.submit-addr-empty {
  color: var(--muted);
  font-size: 24rpx;
}

.submit-remark {
  background: var(--paper-soft);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: var(--text);
  min-height: 100rpx;
  width: 100%;
  box-sizing: border-box;
}

.submit-cta {
  width: 100%;
}

.submit-cta.disabled {
  opacity: 0.6;
}

/* 客服联系卡 */
.wishlist-contact {
  margin-top: 32rpx;
  padding: 32rpx 28rpx;
  background: linear-gradient(160deg, #fff7e3 0%, #fff2d2 100%);
  border: 1rpx solid rgba(224, 172, 77, 0.45);
  border-radius: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.08);
}

.wishlist-contact-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text);
}

.wishlist-qr {
  width: 360rpx;
  height: 360rpx;
  background: #fff;
  border-radius: 22rpx;
  overflow: hidden;
  border: 1rpx solid rgba(234, 223, 206, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
}

.wishlist-qr-image {
  width: 100%;
  height: 100%;
}

.wishlist-wechat-id {
  font-size: 26rpx;
  color: var(--text);
}

.wishlist-wechat-id-strong {
  font-weight: 800;
  color: var(--red);
}

.wishlist-tip {
  font-size: 22rpx;
  color: var(--muted);
}

.wishlist-channels {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--text);
  letter-spacing: 0.04em;
}

.wishlist-channels-tip {
  font-size: 22rpx;
  color: var(--muted);
}

/* 流程折叠 */
.wishlist-flows {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.flow-card {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(234, 223, 206, 0.9);
  border-radius: 22rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(46, 35, 18, 0.08);
}

.flow-summary {
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flow-summary.open {
  color: var(--red);
}

.flow-chevron {
  font-size: 24rpx;
  color: var(--muted);
}

.flow-body {
  padding: 0 28rpx 22rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  border-top: 1rpx solid rgba(234, 223, 206, 0.6);
  padding-top: 16rpx;
}

.flow-step {
  font-size: 24rpx;
  color: #5d5140;
  line-height: 1.7;
}

.bottom-spacer {
  height: 32rpx;
}
